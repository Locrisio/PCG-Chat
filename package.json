{
  "name": "pcg-chat",
  "version": "2.0.0",
  "description": "PCG Chat v2.0 - Mensajeria en tiempo real y P2P para Windows por PCG Studios",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "author": "Mateo - PCG Studios",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "peerjs": "^1.5.4"
  },
  "devDependencies": {
    "electron": "33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.pcgstudios.chat",
    "productName": "PCG Chat",
    "copyright": "Copyright © 2026 Mateo - PCG Studios",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "main.js",
      "index.html",
      "styles.css",
      "app.js",
      "assets/**/*"
    ]
  }
}
